<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the nutrition window's pages to PNG outside the game, from the mod's own page code and a made-up player.
       Run from the repository root: dotnet run -c Release, project tools/preview, with an output folder as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../ComplexNutrition/ComplexNutrition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VintageStoryPath)/Mods/VSSurvivalMod.dll</HintPath></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryPath)/Mods/VSEssentials.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryPath)/Lib/0Harmony.dll</HintPath></Reference>
    <Reference Include="cairo-sharp"><HintPath>$(VintageStoryPath)/Lib/cairo-sharp.dll</HintPath></Reference>
    <Reference Include="protobuf-net"><HintPath>$(VintageStoryPath)/Lib/protobuf-net.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryPath)/Lib/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>

</Project>
